# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Çalışan sistem (canlı sürüm + veritabanı + yedekler + kayıtlar) — asla git'e girmez
canli/
# Geliştirme verisi (gerçek kişilerin kopyası olabilir: saha.db, gizli.key, yedekler, öbekler) — yerel kalır
gelistirme/

# Çalışma verisi NEREDE oluşursa oluşsun git'e girmez (yanlış SAHA_VERI_DIZINI, başıboş bir koşu, eski düzen):
# veritabanları, oturum anahtarı, yedekler, günlükler, fotoğraf/ek klasörleri kişisel veridir.
*.db
*.db-wal
*.db-shm
*.db-journal
gizli.key
**/yedek/
**/kayit/
**/ek/

# Masaüstü uygulaması (kod/masaustu/derle.py üretir; içinde bina verisi var) ve eski kopyası
/Turkcell.exe
/.turkcell/
/DehanetSaha.exe
# Turkcell.exe'nin canlı çalışma klasörü (saha.db, gizli.key, yedekler, WebView2 profili) — asla git'e girmez
/veri/canli/
.turkcell/

# Sunum uygulaması (kod/sunum): bağımlılıklar ve derleme çıktıları
kod/sunum/node_modules/
kod/sunum/dist/
kod/sunum/dist-electron/
kod/sunum/dist-html/
kod/sunum/dist-sunum/
kod/sunum/dist-kesif/
kod/sunum/release/
kod/sunum/vendor-cache/
# Üretilen simge/splash rasterleri (kaynak build/icon.svg sürüm kontrolünde)
kod/sunum/build/icon-*.png
kod/sunum/build/icon.ico
kod/sunum/build/icon.png
kod/sunum/build/splash.bmp
kod/sunum/build/splash.png
kod/sunum/electron/icon.png
# Ekran görüntüleri
kod/sunum/qa/

# Arayüz (kod/arayuz): bağımlılıklar ve derleme çıktıları (ayrıntı: kod/arayuz/.gitignore)
kod/arayuz/node_modules/
kod/arayuz/dist/
kod/arayuz/dist-sahte/

# Masaüstü (kod/masaustu) ve eklenti (kod/eklenti) derlemeleri
kod/masaustu/derleme/
kod/eklenti/node_modules/
kod/eklenti/dist/

# Ara çıktılar — veri/cikti varsayılan olarak git dışında; depoda kalacaklar ! ile açıkça seçilir
/veri/cikti/*
!/veri/cikti/DSALE_Sunum.html
!/veri/cikti/N08_res_hp/
veri/cikti/_onbellek/
veri/cikti/*.exe
veri/cikti/*.mp4
veri/cikti/_*.log
# Sunucunun bölgeleme çıktıları (eski varsayılan yer; artık çalışma klasöründe)
veri/cikti/saha_bolgeleme/

# Operasyon: yüklenen iş emri raporları (kişisel veri — yerel kalır)
kod/operasyon/veri/
*_hazir.xlsx
# v2: öbek tanımları canlı veridir (DB esastır); depoya sentetik kod/operasyon/obekler.ornek.json girer
kod/operasyon/obekler.json

# Operasyon analiz çıktıları — ekip adları ve rapor türevleri içerir (yerel kalır)
kod/operasyon/analiz/cikti/
kod/operasyon/analiz/hakem*/cikti/

# Saha Sistemi faz 2: üretilen önbellek ve yüklenen tur raporları (yerel kalır)
veri/master/bina_kalite_kanit.json
veri/raw/gelen/
