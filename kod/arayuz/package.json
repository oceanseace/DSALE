    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
