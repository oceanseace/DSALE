{
  "name": "dehanet-bursa-fiber",
  "productName": "Bursa Fiber Satış Haritası",
  "version": "1.0.0",
  "private": true,
  "description": "Dehanet EÇM · Bursa Fiber Satış Haritası — 3B sunum ve keşif uygulaması",
  "author": "Dehanet EÇM",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:html": "vite build --mode html",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:start": "vite build && electron .",
    "ikon": "node scripts/ikon.mjs",
    "splash": "node scripts/splash.mjs",
    "dist": "node scripts/ikon.mjs && node scripts/splash.mjs && vite build && electron-builder --win portable",
    "film": "node scripts/film.mjs",
    "qa": "node scripts/qa.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@deck.gl/aggregation-layers": "~9.4.0",
    "@deck.gl/core": "~9.4.0",
    "@deck.gl/extensions": "~9.4.0",
    "@deck.gl/geo-layers": "~9.4.0",
    "@deck.gl/layers": "~9.4.0",
    "@deck.gl/mesh-layers": "~9.4.0",
    "@deck.gl/react": "~9.4.0",
    "@deck.gl/widgets": "~9.4.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@loaders.gl/core": "^4.4.3",
    "@luma.gl/constants": "~9.4.1",
    "@luma.gl/core": "~9.4.1",
    "@luma.gl/engine": "~9.4.1",
    "@luma.gl/shadertools": "~9.4.1",
    "@luma.gl/webgl": "~9.4.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/d3-color": "^3.1.3",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "d3-color": "^3.1.0",
    "d3-ease": "^3.0.1",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "echarts": "^6.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "motion": "^13.4.0",
    "playwright-core": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "build": {
    "appId": "com.dehanet.dsale",
    "productName": "Bursa Fiber Satış Haritası",
    "copyright": "© 2026 TURKCELL SUPERONLINE DEHANET EÇM",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "compression": "normal",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "electronLanguages": [
      "tr",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "forceCodeSigning": false
    },
    "portable": {
      "artifactName": "DSALE_Sunum.exe",
      "unpackDirName": "DSALE_Sunum",
      "splashImage": "build/splash.bmp"
    }
  }
}
